# Скопируйте этот файл в .env и подставьте свои значения.

# Токен бота от @BotFather
BOT_TOKEN=1234567890:AAAA-your-token-here

# Telegram ID менеджеров через запятую (свой ID можно узнать у @userinfobot)
ADMIN_IDS=111111111,222222222

# Файл базы данных (необязательно, по умолчанию bakery.db)
DB_PATH=bakery.db

# Ссылка на опубликованную политику обработки персональных данных (шаблон — PRIVACY.md).
# Пока пусто, бот присылает клиенту сам файл PRIVACY.md.
PRIVACY_POLICY_URL=

# Что делать, когда клиент просит удалить свои данные (/privacy):
#   auto    — обезличить сразу (после завершения его заказов)
#   manager — отправить запрос менеджерам, решение принимают они
PRIVACY_DELETION_MODE=auto

# Токен платёжного провайдера (ЮKassa) от @BotFather → Payments.
# Пусто — онлайн-оплата выключена, остаётся только оплата при получении.
# Тестовый токен выглядит так: 381764678:TEST:12345
PAYMENT_TOKEN=

# Оплата по СБП через API ЮKassa: ID магазина и секретный ключ из личного кабинета
# ЮKassa (Интеграция → Ключи API). Пусто — кнопки «По СБП» нет.
# Ключ тестового магазина начинается с test_, боевого — с live_.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
